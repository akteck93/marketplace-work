NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=1

# Local MongoDB (recommended host form for Node/Mongoose):
MONGODB_URI=mongodb://127.0.0.1:27017/workiffy

# Production example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/workiffy?retryWrites=true&w=majority

JWT_SECRET=replace-with-at-least-48-random-characters-for-production
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Workiffy commercial access switch.
# Keep false until your real subscription payment webhook is connected.
ENFORCE_SUBSCRIPTIONS=false

# Marketplace contact details shown publicly
SUPPORT_EMAIL=support@workiffy.com

# Admin bootstrap (used only by npm run create-admin)
ADMIN_NAME=Workiffy Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-before-running-create-admin
